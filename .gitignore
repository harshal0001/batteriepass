# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Raw battery data never enters the repo. Only derived Parquet features ship,
# and those live under data-cache/ which is also ignored — the Kaggle dataset
# is the distribution channel for them, not git.
data-raw/
data-cache/
*.mat

# Experiment tracking output. Zipped and attached to a release, not committed.
mlruns/
training/checkpoints/

# Node
node_modules/
frontend/dist/

# Local environment
.env
.env.local

# Planning briefs. Kept local: written in portfolio-and-hiring terms that
# read oddly in a public repository. The decisions it drove live in docs/adr/.
project-2-batteriepass*.md

# Agent tooling. The contract (CLAUDE.md, .claude/commands/, docs/) is committed;
# anything personal or generated stays out.
.claude/settings.local.json
.claude/*.local.*
skill-observations/
skill-updates/

# Hypothesis example database: a test cache, regenerated on every run.
.hypothesis/
